# NAVER Cloud Platform의 NAVER API HUB에서 발급받은 검색 API 키
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오디벨로퍼스에서 발급받은 Daum 검색용 REST API 키
KAKAO_REST_API_KEY=

# Google AI Studio Gemini API
# 프로그램별 전용 API 키 사용을 권장합니다.
GEMINI_API_KEY=

# DB에 자동·수동 모델 선택값이 아직 없을 때 사용할 호환 기본 모델
# 실제 선택은 설정 화면의 Gemini 모델 설정에 저장됩니다.
GEMINI_MODEL=gemini-3.6-flash

# 로컬 호출 기록과 캐시를 구분하는 프로그램 식별자
GEMINI_APP_ID=content-trend-tracker
# 예제 범위 ID입니다. 개인 계정명·프로젝트명·조직명을 넣지 말고 로컬 .env에서 필요한 값으로 바꾸세요.
GEMINI_QUOTA_SCOPE_ID=content-trend-tracker-default

# 모든 Gemini 생성 요청이 공유하는 보수적 분당 공통 제한입니다.
# 실제 Google AI Studio 프로젝트 한도가 더 낮으면 그 값으로 낮추고,
# 공식 한도 상승을 직접 확인한 경우에만 값을 올리세요.
GEMINI_RATE_LIMIT_RPM=5
GEMINI_RATE_LIMIT_TPM=250000
# 입력 토큰 추정 오차와 응답 schema·도구 설정 같은 부가 입력을 위한 내부 안전 여유입니다.
# 기본값 10000이면 250000 TPM에서 내부 예약 상한은 240000입니다.
GEMINI_RATE_LIMIT_TPM_SAFETY_MARGIN=10000

# 화면에 표시할 일일 요청 참고 한도
# 실제 제한은 모델·프로젝트 티어와 Google AI Studio의 현재 정책을 따릅니다.
GEMINI_DAILY_REQUEST_REFERENCE_LIMIT=1500

# 일반 Gemini 초안 요청의 제한 시간(초)
GEMINI_TIMEOUT_SECONDS=60

# 주제 방향·요약 요청 1개의 최대 대기 시간(초)
# 예상 완료 시간이 아니라 이 시간이 지나면 해당 요청을 중단하는 상한입니다.
# 현재 기본값은 10분이며, 과거 기본값 360초는 프로그램에서 600초로 자동 보정합니다.
GEMINI_TOPIC_ANGLE_TIMEOUT_SECONDS=600

# 주제 방향·요약 API 요청 1회에 넣을 최대 글감 수
GEMINI_TOPIC_ANGLE_ITEMS_PER_REQUEST=15

# 동시에 겹쳐 실행할 최대 요청 수
# 기본 1이면 상위 글감 최대 15개를 한 요청으로 처리합니다.
# 값을 늘리면 화면의 수동 분석 처리량도 늘어나므로 무료 RPD 한도를 먼저 확인하세요.
GEMINI_TOPIC_ANGLE_MAX_PARALLEL_REQUESTS=1

# 병렬 요청의 시작 간격(초)
# 요청은 0초, 5초, 10초, 15초 순으로 시작합니다.
GEMINI_TOPIC_ANGLE_REQUEST_STAGGER_SECONDS=5

# Gemini 자동 분석을 실행할 최소 글감 기회 점수
# 트렌드 점수 하나가 아니라 최근성·정보성·자료 깊이·사실 위험 등을 반영한 글감 기회 점수입니다.
# 이 점수보다 낮은 글감은 API 사용량 절약을 위해 제외됩니다.
GEMINI_TOPIC_ANGLE_MIN_OPPORTUNITY_SCORE=50

# 429·503 같은 일시 오류가 발생했을 때의 재시도 설정
GEMINI_RETRY_WAIT_SECONDS=2
GEMINI_RETRY_MAX_WAIT_SECONDS=30

# 초안은 사실 확인과 웹 검색이 필요하므로 high 권장
GEMINI_DRAFT_THINKING_LEVEL=high

# 글감 제목·요약·작성 설정·확인 항목·방향 3개 생성은 medium 권장
GEMINI_TOPIC_ANGLE_THINKING_LEVEL=medium
